# Local overrides for the Unisoc vendor_boot recovery environment.
#
# This is a diagnostics image: the recovery binary is disabled in init.rc, so
# all that runs is init, the stock Unisoc services and adbd. The goal is a
# working adb connection on a device that otherwise gives a black screen.

# 1) SELinux. The stock policy is patched at build time so init, recovery,
#    adbd and shell are permissive. Writing enforce here only works because of
#    that patch - a plain `write` from a non-permissive init domain is denied.
on early-init
    write /sys/fs/selinux/enforce 0

# 2) Order matters, and the properties are not interchangeable:
#
#    * sys.usb.configfs must be 1 before `on fs` runs, because init.rc creates
#      the /config/usb_gadget/g1 skeleton in an `on fs && property:...` block.
#
#    * adbd must start only AFTER `on fs` has mounted functionfs at
#      /dev/usb-ffs/adb. adbd opens ep0 there and is the only thing that sets
#      sys.usb.ffs.ready=1, which in turn is what lets
#      init.recovery.common.rc write the UDC and bind the gadget. Starting
#      adbd in `on init` is too early: ep0 does not exist yet, ffs.ready stays
#      0, the gadget never binds and nothing ever enumerates.
#
#    This file is imported at the very end of init.rc, so its `on fs` block is
#    queued after the vendor ones and the mounts are already in place.
on init
    setprop sys.usb.configfs 1

on fs
    setprop sys.usb.config adb,vser,gser
    start adbd
