# Local overrides, imported from init.recovery.${ro.hardware}.rc.
#
# init.rc is TWRP's own. Do NOT publish the vendor "adb,vser,gser" string here:
# init.recovery.common.rc would then symlink functions/vser.gs7 and
# functions/gser.gs0, which TWRP never creates, and the gadget bind aborts.

on early-init
    # Only effective because the stock policy is patched so that init, recovery,
    # adbd and shell are permissive at build time.
    write /sys/fs/selinux/enforce 0

# ---------------------------------------------------------------------------
# Log dumping.
#
# Recovery currently ends up with a lit-but-black panel: no framebuffer
# content, no ADB, and this board has no vibration motor, so there is no way to
# observe progress from outside. /dump.sh copies dmesg, /proc/mounts and the
# DRM/graphics device listings onto the cache partition, which survives the
# reboot and can be read afterwards from a rooted Android system:
#
#     su -c 'mkdir -p /mnt/c && mount /dev/block/by-name/cache /mnt/c'
#     adb pull /mnt/c/dg3
#
# `on fs` is the interesting one: it runs right after the vendor mounts, so even
# if init blocks there the dump already exists.
# ---------------------------------------------------------------------------
on fs
    start dg3dump

on boot
    start dg3dump

service dg3dump /system/bin/sh /dump.sh
    user root
    group root
    oneshot
    disabled
    # shell is permissive thanks to the policy patch, and shell_exec is its own
    # entry point, so executing /system/bin/sh from here is allowed.
    seclabel u:r:shell:s0
