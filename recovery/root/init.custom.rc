on early-init
    write /sys/fs/selinux/enforce 0

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.config adb,vser,gser
    start adbd
    start dg3dump

on fs
    start dg3dump

service dg3dump /system/bin/sh /dump.sh
    user root
    group root
    oneshot
    disabled
    seclabel u:r:shell:s0
