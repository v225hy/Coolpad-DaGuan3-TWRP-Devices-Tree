# Local overrides, imported from init.recovery.${ro.hardware}.rc.
#
# init.rc here is TWRP's own (the vendor copy was tried and hung earlier, at the
# first boot screen). TWRP's init.rc already owns the whole USB gadget flow:
# it creates /config/usb_gadget/g1 with ffs.adb + ffs.fastboot, and writes the
# UDC on `on property:sys.usb.config=adb`. Do NOT publish the vendor string
# "adb,vser,gser" here: init.recovery.common.rc would then try to symlink
# functions/vser.gs7 and functions/gser.gs0, which TWRP never creates, and the
# bind aborts.

on early-init
    # Only effective because the stock policy is patched to make init, recovery,
    # adbd and shell permissive at build time.
    write /sys/fs/selinux/enforce 0

# ---------------------------------------------------------------------------
# Progress beacons.
#
# On this device recovery shows a lit-but-black panel and never brings up ADB,
# so there is no way to see how far init got. A vibration is the one output
# that works without a framebuffer or a USB connection, so pulse it at each
# stage - the pattern tells us where it stops.
#
#   ~100 ms  short tick     -> `on init`      (early init completed)
#   ~400 ms  medium buzz    -> `on late-init` (filesystems up)
#   ~900 ms  long buzz      -> `on boot`      (everything init controls ran)
#
# Durations are deliberately far apart so they can be told apart by feel.
#
# /sys/class/timed_output/vibrator/enable takes a duration in milliseconds.
# ---------------------------------------------------------------------------
on init
    write /sys/class/timed_output/vibrator/enable 100

on late-init
    write /sys/class/timed_output/vibrator/enable 400

on boot
    write /sys/class/timed_output/vibrator/enable 900
