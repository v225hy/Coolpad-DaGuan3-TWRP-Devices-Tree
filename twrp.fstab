# TWRP fstab for Coolpad CP3NV1 (agn2262SG / UMS9620)
# TWRP 专用，去掉 verity/avb 强制项，方便刷写

/system       /system       erofs   ro                              slotselect,first_stage_mount
/system_ext   /system_ext   erofs   ro                              slotselect,first_stage_mount
/vendor       /vendor       erofs   ro                              slotselect,first_stage_mount
/odm          /odm          erofs   ro                              slotselect,first_stage_mount
/product      /product      erofs   ro                              slotselect,first_stage_mount
/vendor_dlkm  /vendor_dlkm  erofs   ro                              slotselect,first_stage_mount

/boot         /boot         emmc    defaults                        slotselect
/dtbo         /dtbo         emmc    defaults                        slotselect
/metadata     /metadata     ext4    noatime,nosuid,nodev            formattable
/persist      /persist      ext4    noatime,nosuid,nodev
/prodnv       /mnt/vendor   ext4    noatime,nosuid,nodev,noauto_da_alloc
/misc         /misc         emmc    defaults
/recovery     /recovery     emmc    defaults                        slotselect

# Data: TWRP 需要能格式化。stock 为 f2fs + FBE
/data         /data         f2fs    noatime,nosuid,nodev,inline_xattr,inline_data,inline_dentry,flush_merge,extent_cache,mode=adaptive,active_logs=6,reserve_root=32768,resuid=0,resgid=1065,checkpoint_merge,fsync_mode=nobarrier
     length=-16384
/data         /data         ext4    noatime,nosuid,nodev,barrier=1,data=ordered
     length=-16384

# 外部存储
/external_sd  /external_sd  auto    noatime,nosuid,nodev             voldmanaged=external_sd:auto
/usb_otg      /usb_otg      auto    noatime,nosuid,nodev             voldmanaged=usb_otg:auto
