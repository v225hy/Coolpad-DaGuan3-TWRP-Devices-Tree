# Android fstab file for Coolpad CP3NV1 (agn2262SG / UMS9620)
# UFS single LUN  -> /dev/block/sda, GPT, 72 partitions
# Slot: _a (androidboot.slot_suffix=_a)
# Filesystems: erofs for system/vendor side, f2fs for /data
# NOTE: dynamic partitions live inside /dev/block/by-name/super

#<src>                                                        <mnt_point>   <type>  <mnt_flags and options>                                  <fs_mgr_flags>
system                                                        /system       erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
system_ext                                                    /system_ext   erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_system,logical,first_stage_mount
vendor                                                        /vendor       erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_vendor,logical,first_stage_mount
odm                                                           /odm          erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_odm,logical,first_stage_mount
product                                                       /product      erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_product,logical,first_stage_mount
vendor_dlkm                                                   /vendor_dlkm  erofs   ro,barrier=1                                             wait,slotselect,avb=vbmeta_system_ext,logical,first_stage_mount

/dev/block/by-name/metadata                                   /metadata     ext4    nodev,noatime,nosuid,errors=panic                        wait,formattable,first_stage_mount,check
/dev/block/by-name/persist                                    /persist      ext4    nodev,noatime,nosuid,errors=panic                        wait
/dev/block/by-name/prodnv                                    /mnt/vendor   ext4    nodev,noatime,nosuid,noauto_da_alloc                     wait
/dev/block/by-name/miscdata                                   /mnt/vendor/miscdata ext4 nodev,noatime,nosuid                                 wait,formattable
/dev/block/by-name/sysdumpdb                                  /mnt/vendor/sysdumpdb ext4 nodev,noatime,nosuid                                wait
/dev/block/by-name/ise_a                                      /mnt/vendor/ise     ext4  nodev,noatime,nosuid                                  wait,slotselect
/dev/block/by-name/calinv                                     /mnt/vendor/calinv  ext4  nodev,noatime,nosuid                                  wait

# data (f2fs, FBE + metadata encryption on stock)
/dev/block/by-name/userdata                                   /data         f2fs    noatime,nosuid,nodev,inline_xattr,inline_data,inline_dentry,flush_merge,extent_cache,mode=adaptive,active_logs=6,reserve_root=32768,resuid=0,resgid=1065,inlinecrypt,checkpoint_merge,fsync_mode=nobarrier
     wait,check,formattable,fileencryption=ice,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,latemount

# Removable
/dev/block/mmcblk0p1                                          /external_sd  vfat    noatime,nosuid,nodev,barrier=1                            wait,check
/dev/block/mmcblk0p1                                          /external_sd  exfat   noatime,nosuid,nodev                                     wait,check,force_fsgid=sdcard_rw
/dev/block/mmcblk0p1                                          /external_sd  ntfs    noatime,nosuid,nodev                                     wait,check

# USB OTG
/dev/block/sdg1                                               /usb_otg      auto    defaults                                                 voldmanaged=usb_otg:auto
/devices/platform/soc/soc:ap-ahb/23000000.usb*/*               auto          auto    defaults                                                 voldmanaged=usb_drive:auto
