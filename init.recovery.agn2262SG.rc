# TWRP's init.rc imports /init.recovery.${ro.hardware}.rc (this file) but NOT
# /init.recovery.common.rc, whereas the stock init.rc imports common.rc on its
# very first line. Everything Unisoc puts in there - the configfs USB gadget,
# the splloader by-name links, mlogservice, and the whole set of on init /
# on boot / on fs / on post-fs-data actions - therefore never ran under TWRP,
# so the vendor side of recovery was half-initialised.
#
# Same pattern as ZTE-7552N-P720S20-devicetree, where
# init.recovery.ums9620_2h10.rc line 2 is exactly this import.
import /init.recovery.common.rc

#
# init.recovery.agn2262SG.rc
# Coolpad CP3NV1 (酷派大观3) / Unisoc UMS9620 (qogirn6pro) / board agn2262SG
#
# =====================================================================
# 展讯 TWRP DRM 修复 —— 加载顺序依据
# =====================================================================
# 本文件顺序严格对齐原厂 vendor_boot vendor_ramdisk 内的
#   /lib/modules/modules.load.recovery      (164 行，原厂 recovery 专用)
# 只截取 TWRP 显示/触摸/存储必需的最小子集，保持相对顺序不变。
#
# 关键依赖链（由 ELF 符号表实测确认）：
#   trusty.ko          导出 trusty_fast_call32
#   sprd-drm.ko        引用 trusty_fast_call32  → 必须先加载 trusty.ko
#   sprd-gsp.ko        引用 trusty_fast_call32  → 必须先加载 trusty.ko
#   sprd-drm.ko        引用 sprd_iommu_map/unmap/restore → 必须先 unisoc-iommu.ko
#   sprd-drm.ko        引用 ptn38003a_dp_* → 必须先 ptn38003a-i2c.ko（原厂确实排在很后）
#   sprd-drm.ko        引用 devm_pwm_get / pwm_apply_state + sprd_pwm_backlight_update
#                                        → 必须先 pwm-sprd.ko
#   sprd-gsp.ko        引用 apsys_* / sprd_iommu_* → 必须先 apsys-dvfs.ko / unisoc-iommu.ko
#
# 原厂顺序片段（节选，行号为 modules.load.recovery 实际行号）：
#   24: sprd_soc_id.ko        26: ufs-sprd-qogirn6pro.ko
#   27: trusty.ko             28: trusty-pm.ko      29: trusty-log.ko
#   30: trusty-irq.ko         31: trusty-ipc.ko      32: trusty-virtio.ko
#   33: sprd_shm.ko
#   35: sdhci-sprd.ko
#   71: unisoc-iommu.ko       72: pwm-sprd.ko        73: jpg.ko
#   74: apsys-dvfs.ko         77: sprd-drm.ko        78: sprd-gsp.ko
#   99: ptn38003a-i2c.ko     163: chipone-tddi-icnl9916.ko
# =====================================================================

on early-init
    # SELinux 必须先放开，否则 insmod 与 sysfs 读写都会被拒
    write /sys/fs/selinux/checkreqprot 0
    mkdir /lib/modules
    write /proc/sys/kernel/printk "7 4 1 7"

on init
    export PATH /sbin:/system/bin:/vendor/bin

    # ---------- 阶段 0：基础时钟/SoC ID（DRM 读取 soc id 判断平台） ----------
    insmod /lib/modules/sprd_soc_id.ko

    # ---------- 阶段 1：Trusty 信任执行环境 ----------
    # sprd-drm / sprd-gsp 都引用 trusty_fast_call32，缺一个就 Unknown symbol
    insmod /lib/modules/trusty.ko
    insmod /lib/modules/trusty-pm.ko
    insmod /lib/modules/trusty-log.ko
    insmod /lib/modules/trusty-irq.ko
    insmod /lib/modules/trusty-ipc.ko
    insmod /lib/modules/trusty-virtio.ko
    insmod /lib/modules/sprd_shm.ko

    # ---------- 阶段 2：IOMMU / DVFS / PWM ----------
    # DPU 走 iommuvaul6p-dispc，GSP 走 iommuvaul6p-gsp/gsp1
    insmod /lib/modules/unisoc-iommu.ko
    insmod /lib/modules/pwm-sprd.ko
    insmod /lib/modules/apsys-dvfs.ko

    # ---------- 阶段 3：DRM 主控（顺序同原厂：drm 先于 gsp） ----------
    insmod /lib/modules/sprd-drm.ko
    insmod /lib/modules/sprd-gsp.ko

    # ---------- 阶段 4：DSI redriver（原厂排在靠后，drm 支持 deferred probe） ----------
    insmod /lib/modules/ptn38003a-i2c.ko

    # ---------- 阶段 5：触摸（chipone-tddi on SPI1 @0x70000） ----------
    insmod /lib/modules/chipone-tddi-icnl9916.ko

on post-fs
    # DRM 节点：TWRP minui / gralloc 需要 rw
    chmod 0666 /dev/dri/card0
    chown system graphics /dev/dri/card0
    chmod 0666 /dev/dri/renderD128
    chown system graphics /dev/dri/renderD128

    # 背光 sysfs
    # 实测节点名是 sprd_backlight（不是 sprd-qogirn6pro-backlight），
    # max_brightness = 255（不是 dtb 里的 880，880 是 pwm 内部 scale）。
    chown system system /sys/class/backlight/sprd_backlight/brightness
    chmod 0664 /sys/class/backlight/sprd_backlight/brightness
    chmod 0644 /sys/class/backlight/sprd_backlight/max_brightness

on boot
    # 点亮背光。实测 max_brightness=255，取满值避免暗屏误判为"没显示"。
    write /sys/class/backlight/sprd_backlight/brightness 255

on property:ro.boot.hardware=agn2262SG
    # 平台确认后输出 DRM 状态，便于 adb 侧定位
    write /dev/kmsg "twrp: agn2262SG DRM stack init requested"
